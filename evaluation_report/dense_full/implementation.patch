+
+def main():
+    def terminate(signum,frame):raise SystemExit(128+signum)
+    signal.signal(signal.SIGTERM,terminate)
+    BULK.mkdir(parents=True,exist_ok=True);REPORT.mkdir(parents=True,exist_ok=True)
+    lock=(BULK/'queue.lock').open('a');fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
+    os.environ['DENSE_LOCK_FDS']=','.join(filter(None,[os.environ.get('DENSE_LOCK_FDS',''),str(lock.fileno())]))
