+"""Detached, locked, serial queue; fail closed on scientific/provenance errors."""
+import csv,fcntl,json,os,signal,subprocess,sys,time,traceback
+from pathlib import Path
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+from scripts.dense_common import *
+
+def refresh(state):
+    state['model']=MODEL;state['updated_unix']=time.time()
+    write(BULK/'queue_state.json',state);write(REPORT/'queue_status.json',state)
+    lines=[f'# {MODEL}: full-suite evaluation','',
+        'Native Dense architecture (one pass); NFE10; seeds42/43/44; four suites × ten tasks × 50 episodes/seed = 6,000 scored episodes.','',
+        '| Status | Stage | Episodes | Successes | SR | Backend/workers |','| --- | --- | --- | --- | --- | --- |']
+    for j in state['jobs']:
+        progress=j.get('summary',j.get('progress',{}) if j.get('stage')=='scored' else {})
+        n=progress.get('episodes',progress.get('completed',0));ok=progress.get('successes',0);chosen=j.get('selected',{})
+        rate=f'{100*ok/n:.2f}%' if n else 'pending'
+        lines.append(f"| {j['status']} | {j.get('stage','pending')} | {n}/6000 | {ok} | {rate} | {chosen.get('backend','pending')}/{chosen.get('workers','pending')} |")
+    lines+=['','Calibration is excluded from SR. Partial SR is provisional. Errors stop this queue.',
+        '[Frozen protocol](protocol.json) · [Queue state](queue_status.json)',f'Bulk artifacts: `{BULK}`.',
+        'Every scored episode retains a video and hashed action-query trace. Resume replays incomplete task/seed groups to preserve RNG.']
+    (REPORT/'report.md').write_text('\n'.join(lines)+'\n')
+
+def execute(command,log,state,job=None,env=None):
