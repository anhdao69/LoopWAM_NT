+"""Require both previous runs to finish and pass their audits before GPU work."""
+import json
+import shlex
+import subprocess
+import time
+from pathlib import Path
+from dependency_snapshot import snapshot
+from prerequisites import dependency_ready
+from report import B
+from queue_safety import publish_runtime
+
+LOCAL=Path('/data14t/anhdh35/loopwam_robotwin_elastic_e0_teacher10_5ep_20261111')
+REMOTE='/media/vmo-perception/disk_2/anhdh35/loopwam_robotwin_elastic_e0_teacher10_5ep_20261111'
+
+
+def publish_dependency_receipt(path,local,remote,sha):
+    if not dependency_ready(local,'flat_k1_n2',sha) or not dependency_ready(remote,'flat_k2_n2',sha):
+        raise ValueError('Cannot publish incomplete dependencies')
+    def stable(record):
+        return dict(queue={k:record['queue'][k] for k in ['stage','final_audit_passed','scored_episodes']},
+                    audit={k:record['audit'][k] for k in ['status','verified_pairs','verified_videos','checkpoint_sha256','complete_sha256']},
+                    manifest=record['manifest'],complete_sha256=record['complete_sha256'])
+    receipt=dict(local=stable(local),remote137=stable(remote),created_unix=time.time(),passed=True)
+    publish_runtime(path,receipt)
+    return json.loads(Path(path).read_text())
+
+
+def wait_for_predecessors(status):
+    sha=json.loads((B/'host_config.json').read_text())['checkpoint_sha256']
+    while True:
+        try:
+            local=snapshot(LOCAL,'flat_k1_n2')
+            command=['ssh','-S','/tmp/loopwam-remote-20261104/control','-o','BatchMode=yes',
+                     '-o','ConnectTimeout=8','anhdh35@10.148.182.137',
+                     shlex.join(['python3','-',REMOTE,'flat_k2_n2'])]
+            result=subprocess.run(command,input=(B/'scripts/dependency_snapshot.py').read_text(),
+                                  text=True,capture_output=True,timeout=25,check=True)
+            remote=json.loads(result.stdout)
+        except (OSError,subprocess.SubprocessError,json.JSONDecodeError) as exc:
+            status('waiting_for_predecessors',detail=f'Cannot verify predecessor yet: {type(exc).__name__}')
+            time.sleep(30);continue
+        ready_local=dependency_ready(local,'flat_k1_n2',sha)
+        ready_remote=dependency_ready(remote,'flat_k2_n2',sha)
+        if ready_local and ready_remote:
+            return publish_dependency_receipt(B/'dependency_receipt.json',local,remote,sha)
+        status('waiting_for_predecessors',local_complete=ready_local,remote_complete=ready_remote)
+        time.sleep(30)
